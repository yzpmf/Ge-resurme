# 复制为 .env 并填写真实值（.env 不要提交到 git）
PORT=3001
# 生产环境务必改成你的站点域名，避免被别的网站盗用接口
ALLOW_ORIGIN=https://gezhenghao.com

# SMTP 发信配置（以 QQ 邮箱为例；163 用 smtp.163.com）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=你的发信邮箱@qq.com
# 注意：这里填“授权码”，不是邮箱登录密码（QQ/163 在邮箱设置里开启 SMTP 后生成）
SMTP_PASS=你的SMTP授权码

# 发件人 / 收件人
MAIL_FROM=你的发信邮箱@qq.com
MAIL_TO=接收留言的邮箱@example.com
